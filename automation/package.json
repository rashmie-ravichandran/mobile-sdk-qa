{
  "name": "sdk-networking-contract-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared networking/error-handling contract scenarios for the mobile SDK, run against simulated iOS and Android implementations",
  "scripts": {
    "test": "vitest run",
    "test:ios35": "cross-env IOS_SDK_VERSION=3.5.0 vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "tsx tools/mutation-check.ts",
    "triage": "tsx tools/make-synthetic-runs.ts && tsx tools/flake-triage.ts data/synthetic-runs.json",
    "native:emit": "tsx tools/emit-outcomes.ts",
    "native:compare": "tsx tools/compare-outcomes.ts",
    "triage:file": "tsx tools/flake-triage.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
